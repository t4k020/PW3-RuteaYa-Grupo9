@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_AuthLayout";
}

<div class="auth">
    <aside class="auth-panel">
        <div class="brand">RuteaYa</div>

        <div class="panel-message">
            <h1>Tu ruta, tus paquetes, un solo lugar.</h1>
            <p>Ingresá para gestionar tus viajes, envíos y oportunidades.</p>
        </div>

        <p class="panel-footer">Compartí el camino y hacé rendir cada viaje.</p>
    </aside>

    <main class="auth-content">
        <form class="auth-form"
              asp-controller="Auth"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <h2>Iniciar sesión</h2>
            <p class="subtitle">Accedé a tu cuenta de RuteaYa.</p>

            @if (TempData["RegisterSuccess"] is string mensajeExito)
            {
                <div class="message info">@mensajeExito</div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="message error">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <div class="field">
                <label for="email">Correo electrónico</label>

                <input id="email"
                       name="email"
                       type="email"
                       autocomplete="email"
                       placeholder="usuario@correo.com"
                       required />
            </div>

            <div class="field">
                <label for="password">Contraseña</label>

                <input id="password"
                       name="password"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Tu contraseña"
                       required />
            </div>

            <button type="submit" class="btn">Ingresar</button>

            <p class="auth-switch">
                ¿No tenés cuenta?
                <a asp-controller="Auth" asp-action="Register">Registrate</a>
            </p>
        </form>
    </main>
</div>
