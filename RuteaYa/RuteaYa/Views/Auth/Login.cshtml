
@{
    ViewData["Title"] = "Iniciar sesión";
    /* Se deberia implementar un layout personalizado para login */
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow p-4">

                <h2 class="text-center mb-4">
                    Iniciar sesión
                </h2>

                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Correo electrónico
                        </label>

                        <input name="email"
                               type="email"
                               class="form-control"
                               placeholder="usuario@correo.com"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Contraseña
                        </label>

                        <input name="password"
                               type="password"
                               class="form-control"
                               placeholder="Tu contraseña"
                               required />
                    </div>

                    <button type="submit"
                            class="btn btn-primary w-100">
                        Ingresar
                    </button>
             
                </form>

                <div class="text-center mt-3">
                    ¿No tenés cuenta?
                    <a asp-controller="Auth"
                       asp-action="Register">
                        Registrate
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>
