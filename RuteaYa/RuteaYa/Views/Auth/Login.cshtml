@{
    ViewData["Title"] = "RuteaYa - Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - RuteaYa</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>
<body>
    <div class="auth">
        <section class="auth-panel">
            <div class="brand">RuteaYa</div>

            <div class="panel-message">
                <h1>Convertí tus viajes habituales en una oportunidad.</h1>
                <p>
                    Compartí el espacio libre de tus recorridos
                    y ganá dinero llevando paquetes.
                </p>
            </div>

            <p class="panel-footer">
                Tu recorrido puede conectar mucho más.
            </p>
        </section>

        <main class="auth-content">
            <form id="authForm" class="auth-form">
                <h2 id="formTitle">Ingresar</h2>

                <p class="subtitle" id="formSubtitle">
                    Accedé a tu cuenta de RuteaYa.
                </p>

                <div id="formMessage"
                     class="message"
                     role="status"
                     aria-live="polite"></div>

                <div id="nameFields" class="name-fields" hidden>
                    <div class="field">
                        <label for="nombre">Nombre</label>
                        <input id="nombre"
                               name="nombre"
                               autocomplete="given-name"
                               placeholder="Tu nombre"
                               disabled />
                    </div>

                    <div class="field">
                        <label for="apellido">Apellido</label>
                        <input id="apellido"
                               name="apellido"
                               autocomplete="family-name"
                               placeholder="Tu apellido"
                               disabled />
                    </div>
                </div>

                <div class="field">
                    <label for="email">Email</label>
                    <input id="email"
                           name="email"
                           type="email"
                           placeholder="tu@email.com"
                           autocomplete="email"
                           required />
                </div>

                <div class="field">
                    <label for="password">Contraseña</label>
                    <input id="password"
                           name="password"
                           type="password"
                           placeholder="Mínimo 8 caracteres"
                           autocomplete="current-password"
                           minlength="8"
                           required />
                </div>

                <div id="confirmField" class="field" hidden>
                    <label for="confirmPassword">
                        Confirmar contraseña
                    </label>
                    <input id="confirmPassword"
                           name="confirmPassword"
                           type="password"
                           placeholder="Repetí tu contraseña"
                           autocomplete="new-password"
                           disabled />
                </div>

                <button type="submit"
                        id="submitButton"
                        class="btn">
                    Ingresar
                </button>

                <p class="auth-switch">
                    <span id="switchText">
                        ¿Todavía no tenés una cuenta?
                    </span>
                    <a href="#registro" id="switchLink">
                        Crear cuenta
                    </a>
                </p>
            </form>
        </main>
    </div>

    <script>
            const form = document.getElementById("authForm");
            const nameFields = document.getElementById("nameFields");
            const confirmField = document.getElementById("confirmField");
            const confirmPassword = document.getElementById("confirmPassword");
            const password = document.getElementById("password");
            const email = document.getElementById("email");
            const message = document.getElementById("formMessage");

            let isRegister = location.hash === "#registro";

            function renderForm() {
                isRegister = location.hash === "#registro";

                document.getElementById("formTitle").textContent =
                    isRegister ? "Crear cuenta" : "Ingresar";

                document.getElementById("formSubtitle").textContent =
                    isRegister
                        ? "Registrate para empezar a usar RuteaYa."
                        : "Accedé a tu cuenta de RuteaYa.";

                document.getElementById("submitButton").textContent =
                    isRegister ? "Crear cuenta" : "Ingresar";

                document.getElementById("switchText").textContent =
                    isRegister
                        ? "¿Ya tenés una cuenta?"
                        : "¿Todavía no tenés una cuenta?";

                document.getElementById("switchLink").textContent =
                    isRegister ? "Ingresar" : "Crear cuenta";

                document.getElementById("switchLink").href =
                    isRegister ? "#login" : "#registro";

                nameFields.hidden = !isRegister;
                confirmField.hidden = !isRegister;

                nameFields.querySelectorAll("input").forEach(input => {
                    input.disabled = !isRegister;
                    input.required = isRegister;
                });

                confirmPassword.disabled = !isRegister;
                confirmPassword.required = isRegister;

                password.autocomplete = isRegister
                    ? "new-password"
                    : "current-password";

                password.minLength = isRegister ? 8 : 1;
                message.textContent = "";
                message.className = "message";
            }

            document.getElementById("switchLink").addEventListener("click", () => {
                // El cambio de hash dispara renderForm.
            });

            window.addEventListener("hashchange", renderForm);

            form.addEventListener("submit", event => {
                event.preventDefault();
                message.textContent = "";
                message.className = "message";

                if (!form.reportValidity()) return;

                if (isRegister && password.value !== confirmPassword.value) {
                    message.textContent = "Las contraseñas no coinciden.";
                    message.classList.add("error");
                    confirmPassword.focus();
                    return;
                }

                message.textContent = isRegister
                    ? "Formulario de registro validado. La creación de cuenta todavía no está conectada."
                    : "Formulario de login validado. La autenticación todavía no está conectada.";

                message.classList.add("info");
            });

            renderForm();
    </script>
</body>
</html>
