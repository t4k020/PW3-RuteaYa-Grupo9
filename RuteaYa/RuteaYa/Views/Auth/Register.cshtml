@model RuteaYa.Entidades.RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_AuthLayout";
}

<div class="auth">
    <aside class="auth-panel">
        <div class="brand">RuteaYa</div>

        <div class="panel-message">
            <h1>Sumate y empezá a mover paquetes.</h1>
            <p>Creá tu cuenta para publicar viajes, envíos y encontrar oportunidades.</p>
        </div>

        <p class="panel-footer">Un mismo usuario puede ser conductor y remitente.</p>
    </aside>

    <main class="auth-content">
        <button type="button" data-theme-toggle class="theme-toggle">🌙 Modo oscuro</button>

        <form class="auth-form"
              asp-controller="Auth"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <h2>Crear cuenta</h2>
            <p class="subtitle">Completá tus datos para registrarte.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="message error" style="@(ViewData.ModelState.Where(m => string.IsNullOrEmpty(m.Key)).SelectMany(m => m.Value.Errors).Any() ? "" : "display: none;")">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <div class="name-fields">
                <div class="field">
                    <label asp-for="Nombre">Nombre</label>
                    <input asp-for="Nombre" placeholder="Tu nombre" required />
                </div>

                <div class="field">
                    <label asp-for="Apellido">Apellido</label>
                    <input asp-for="Apellido" placeholder="Tu apellido" required />
                </div>
            </div>

            <div class="field">
                <label asp-for="Email">Correo electrónico</label>
                <input asp-for="Email" type="email" placeholder="usuario@correo.com" required />
            </div>

            <div class="field">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" type="password" placeholder="Mínimo 8 caracteres" minlength="8" required />
                <span asp-validation-for="Password" style="color: #dc3545; font-size: 0.875em;"></span>
            </div>

 
            <div class="field">
                <label asp-for="RepetirPassword">Repetir contraseña</label>

                <input asp-for="RepetirPassword"
                       type="password"
                       placeholder="Volvé a escribir tu contraseña"
                       minlength="8"
                       required
                       onblur="validarCoincidencia()" /> <!-- Usamos onblur en vez de oninput -->
                <!-- Mensaje de error del Servidor (C#) - Se muestra al hacer clic en Registrarme -->
                <span asp-validation-for="RepetirPassword" style="color: #dc3545; font-size: 0.875em;"></span>

            </div>

            <button type="submit" class="btn">Registrarme</button>

            <p class="auth-switch">
                ¿Ya tenés cuenta?
                <a asp-controller="Auth" asp-action="Login">Iniciá sesión</a>
            </p>
        </form>
    </main>

</div>
<script>
    function validarCoincidencia() {
        const pass1 = document.getElementById('Password').value;
        const pass2 = document.getElementById('RepetirPassword').value;

        const errorSpanServidor = document.querySelector('span[data-valmsg-for="RepetirPassword"]');

        if (pass2.length > 0 && pass1 !== pass2) {

            if (errorSpanServidor) {
                errorSpanServidor.innerText = "Las contraseñas no coinciden.";
                errorSpanServidor.style.display = "block";
            }
        } else {

            if (errorSpanServidor) {
                errorSpanServidor.innerText = "";
                errorSpanServidor.style.display = "none";
            }
        }
    }

    document.querySelector('form').addEventListener('submit', function (e) {
        const pass1 = document.getElementById('Password').value;
        const pass2 = document.getElementById('RepetirPassword').value;

        if (pass1 !== pass2) {
            e.preventDefault(); 
            validarCoincidencia(); 
        }
    });
</script>
