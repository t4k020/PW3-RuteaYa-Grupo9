@{
    ViewData["Title"] = "Crear cuenta";
    Layout = "_AuthLayout";
}

<div class="auth">
    <aside class="auth-panel">
        <div class="brand">RuteaYa</div>

        <div class="panel-message">
            <h1>Sumate y empezá a mover paquetes.</h1>
            <p>Creá tu cuenta para publicar viajes, envíos y encontrar oportunidades.</p>
        </div>

        <p class="panel-footer">Un mismo usuario puede ser conductor y remitente.</p>
    </aside>

    <main class="auth-content">
        <form class="auth-form"
              asp-controller="Auth"
              asp-action="Register"
              method="post">

            @Html.AntiForgeryToken()

            <h2>Crear cuenta</h2>
            <p class="subtitle">Completá tus datos para registrarte.</p>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="message error">
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <div class="name-fields">
                <div class="field">
                    <label for="nombre">Nombre</label>

                    <input id="nombre"
                           name="nombre"
                           autocomplete="given-name"
                           placeholder="Tu nombre"
                           required />
                </div>

                <div class="field">
                    <label for="apellido">Apellido</label>

                    <input id="apellido"
                           name="apellido"
                           autocomplete="family-name"
                           placeholder="Tu apellido"
                           required />
                </div>
            </div>

            <div class="field">
                <label for="email">Correo electrónico</label>

                <input id="email"
                       name="email"
                       type="email"
                       autocomplete="email"
                       placeholder="usuario@correo.com"
                       required />
            </div>

            <div class="field">
                <label for="passwordHash">Contraseña</label>

                <input id="passwordHash"
                       name="passwordHash"
                       type="password"
                       autocomplete="new-password"
                       placeholder="Mínimo 8 caracteres"
                       minlength="8"
                       required />
            </div>

            <button type="submit" class="btn">Registrarme</button>

            <p class="auth-switch">
                ¿Ya tenés cuenta?
                <a asp-controller="Auth" asp-action="Login">Iniciá sesión</a>
            </p>
        </form>
    </main>
</div>
