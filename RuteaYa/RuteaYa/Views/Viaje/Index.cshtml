@model IEnumerable<RuteaYa.Servicios.Dtos.ViajeListadoDto>

@{
    ViewData["Title"] = "Mis viajes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Mis viajes</h2>
            <p class="text-muted mb-0">Tus recorridos habituales.</p>
        </div>
        <a asp-action="Crear" class="btn btn-dark">Nuevo viaje</a>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success">@TempData["Mensaje"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <!-- Filtros visuales (opcionales según tu diseño) -->
    <div class="mb-4">
        <a asp-action="Index" asp-route-filtro="activos"
           class="badge rounded-pill @(ViewBag.FiltroActual == "activos" ? "bg-dark" : "bg-light text-dark border") px-3 py-2 me-1 text-decoration-none">
            Activos
        </a>
        <a asp-action="Index" asp-route-filtro="inactivos"
           class="badge rounded-pill @(ViewBag.FiltroActual == "inactivos" ? "bg-dark" : "bg-light text-dark border") px-3 py-2 me-1 text-decoration-none">
            Inactivos
        </a>
        <a asp-action="Index" asp-route-filtro="todos"
           class="badge rounded-pill @(ViewBag.FiltroActual == "todos" ? "bg-dark" : "bg-light text-dark border") px-3 py-2 text-decoration-none">
            Todos
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="d-flex flex-column gap-3">
            @foreach (var item in Model)
            {
                <div class="card shadow-sm border rounded-4 p-3">
                    <div class="d-flex justify-content-between align-items-center">

                        <!-- Columna Izquierda: Origen -> Destino y Días/Horarios -->
                        <div>
                            <h5 class="mb-1 fw-bold text-dark">
                                @item.OrigenDir &rarr; @item.DestinoDir
                            </h5>
                            <p class="text-muted small mb-0">
                                @if (item.DiasSemana != null && item.DiasSemana.Any())
                                {
                                    <span>@string.Join(", ", item.DiasSemana)</span>
                                    <span> &middot; </span>
                                }
                                <span>@item.HoraSalida.ToString("HH:mm") &ndash; @item.HoraLlegada.ToString("HH:mm")</span>
                            </p>
                        </div>

                        <!-- Columna Derecha: Estado y Botones de Acción -->
                        <div class="d-flex align-items-center gap-2">
                            @if (item.Activo)
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-3 py-2 rounded-pill">Inactivo</span>
                            }

                            <a asp-action="Detalles" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Ver detalle</a>

                            <!-- Botón Oportunidades (si lo usás en tu lógica) -->
                            <a href="#" class="btn btn-outline-secondary btn-sm rounded-pill px-3">Oportunidades</a>

                            <!-- Formulario o botón para Desactivar / Eliminar -->
                            <form asp-action="Desactivar" asp-route-id="@item.Id" method="post" style="display:inline;" onsubmit="return confirm('¿Estás seguro de desactivar este viaje?');">
                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">Desactivar</button>
                            </form>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm border rounded-4 p-5 text-center text-muted">
            <p class="mb-0">No hay viajes registrados o no se pudo conectar con la API.</p>
        </div>
    }
</div>