@model RuteaYa.Servicios.Dtos.CrearViajeDto
@using RuteaYa.Models


@{
    ViewData["Title"] = "Editar viaje";

    var viajeId = ViewData["ViajeId"];
    var paradas = Model.Paradas;
    var todosLosDias = new (byte Numero, string Nombre)[]
    {
        (1, "Lun"),
        (2, "Mar"),
        (3, "Mié"),
        (4, "Jue"),
        (5, "Vie"),
        (6, "Sáb"),
        (7, "Dom")
    };
    var dias = todosLosDias.Where(dia => Model.DiasSemana.Contains(dia.Numero)).ToList();
}

<div class="container mt-4">
    @* Aviso general: se muestra al intentar guardar con datos inválidos. *@
    <div id="aviso-validacion"
         class="alert alert-danger rounded-4 shadow-sm mb-4 @(ViewData.ModelState.IsValid ? "d-none" : string.Empty)"
         role="alert" aria-live="assertive">
        <div class="d-flex align-items-start gap-2">
            <span aria-hidden="true">⚠️</span>
            <span>Datos incorrectos, revisá los datos.</span>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold mb-1">Editar viaje</h2>
            <p class="text-muted mb-0">Modificá los datos de tu recorrido habitual.</p>
        </div>
        <a asp-action="Detalle" asp-route-id="@viajeId" class="btn btn-outline-secondary rounded-pill px-3">Volver</a>
    </div>

    <form asp-action="Actualizar" asp-route-id="@viajeId" method="post" id="form-viaje">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <!-- Recorrido -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="bg-light border-bottom px-4 py-3">
                <h5 class="mb-1">Recorrido</h5>
                <p class="text-muted small mb-0">Indicá desde dónde salís y a dónde vas.</p>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="OrigenDir" class="form-label">Origen</label>
                        <input asp-for="OrigenDir" class="form-control" maxlength="150" required placeholder="Ej.: Av. Triunvirato 4200, CABA" />
                        <div class="form-text">Punto de partida del viaje.</div>
                        <span asp-validation-for="OrigenDir" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="DestinoDir" class="form-label">Destino</label>
                        <input asp-for="DestinoDir" class="form-control" maxlength="150" required placeholder="Ej.: Lanús" />
                        <div class="form-text">Punto de llegada del viaje.</div>
                        <span asp-validation-for="DestinoDir" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Paradas intermedias -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="bg-light border-bottom px-4 py-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                    <h5 class="mb-1">Paradas intermedias (opcional)</h5>
                    <p class="text-muted small mb-0">Se recorren en el orden en que las agregás.</p>
                </div>
                <span class="badge rounded-pill text-bg-dark" id="contador-paradas">@paradas.Count</span>
            </div>
            <div class="p-4">
                <div id="paradas-container" class="d-flex flex-column gap-3">
                    @for (var i = 0; i < paradas.Count; i++)
                    {
                        <div class="card border rounded-4 p-3" data-parada-row>
                            <div class="row g-2 align-items-center">
                                <div class="col-auto">
                                    <span class="badge rounded-pill text-bg-dark parada-numero">@(i + 1)</span>
                                </div>
                                <div class="col">
                                    <input asp-for="Paradas[i].Direccion" class="form-control" maxlength="150"
                                           placeholder="Ej.: Chacarita" data-parada-direccion />
                                    <span asp-validation-for="Paradas[i].Direccion" class="text-danger small d-block"></span>
                                </div>
                                <div class="col-auto">
                                    <div class="btn-group" role="group" aria-label="Acciones de la parada">
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-mover-arriba
                                                title="Mover arriba" aria-label="Mover parada arriba">
                                            &uarr;
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" data-mover-abajo
                                                title="Mover abajo" aria-label="Mover parada abajo">
                                            &darr;
                                        </button>
                                        <button type="button" class="btn btn-outline-danger btn-sm" data-eliminar-parada
                                                title="Eliminar" aria-label="Eliminar parada">
                                            &times;
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <p id="paradas-vacio"
                   class="text-muted small mb-0 @(paradas.Count > 0 ? "d-none" : "")">
                    Todavía no agregaste paradas. El viaje puede guardarse solo con origen y destino.
                </p>

                <button type="button" class="btn btn-outline-dark rounded-pill px-3 mt-3" id="btn-agregar-parada">
                    + Agregar parada
                </button>
            </div>
        </div>

        <!-- Días y horarios -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="bg-light border-bottom px-4 py-3">
                <h5 class="mb-1">Días y horarios</h5>
                <p class="text-muted small mb-0">Horarios en los que hacés este recorrido.</p>
            </div>
            <div class="p-4">
                @if (dias.Any())
                {
                    <label class="form-label">Días de la semana</label>
                    <div class="d-flex flex-wrap gap-2 mb-1">
                        @foreach (var dia in dias)
                        {
                            @* Viaja oculto para que el PUT conserve los días del viaje. *@
                            <input type="hidden" name="DiasSemana" value="@dia.Numero" />
                            <span class="badge rounded-pill text-bg-dark px-3 py-2 fw-normal">@dia.Nombre</span>
                        }
                    </div>
                    <div class="form-text">Los días no se pueden modificar desde esta pantalla.</div>
                }

                <div class="row g-3 @(dias.Any() ? "mt-2" : string.Empty)">
                    <div class="col-md-6">
                        <label asp-for="HoraSalida" class="form-label">Hora de salida</label>
                        <input asp-for="HoraSalida" type="time" class="form-control" asp-format="{0:HH:mm}" required />
                        <span asp-validation-for="HoraSalida" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="HoraLlegada" class="form-label">Hora de llegada</label>
                        <input asp-for="HoraLlegada" type="time" class="form-control" asp-format="{0:HH:mm}" required />
                        <div class="form-text">Debe ser posterior a la hora de salida.</div>
                        <span asp-validation-for="HoraLlegada" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Capacidad y límites -->
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
            <div class="bg-light border-bottom px-4 py-3">
                <h5 class="mb-1">Capacidad y límites</h5>
                <p class="text-muted small mb-0">Definí cuánto podés llevar y cuánto desvío aceptás.</p>
            </div>
            <div class="p-4">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="MaxPaquetes" class="form-label">Paquetes máximos</label>
                        <input asp-for="MaxPaquetes" class="form-control" type="number" min="1" step="1" required />
                        <div class="form-text">Debe ser mayor que cero.</div>
                        <span asp-validation-for="MaxPaquetes" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="PesoMaxKg" class="form-label">Peso máximo (kg)</label>
                        <div class="input-group">
                            <input asp-for="PesoMaxKg" class="form-control" type="number" min="0.01" step="0.01" required />
                            <span class="input-group-text">kg</span>
                        </div>
                        <div class="form-text">Debe ser mayor que cero.</div>
                        <span asp-validation-for="PesoMaxKg" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="DesvioMaxKm" class="form-label">Desvío máximo (km)</label>
                        <div class="input-group">
                            <input asp-for="DesvioMaxKm" class="form-control" type="number" min="0" step="0.1" required />
                            <span class="input-group-text">km</span>
                        </div>
                        <div class="form-text">Si no querés desvíos, ingresá 0 km.</div>
                        <span asp-validation-for="DesvioMaxKm" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-5">
            <a asp-action="Detalle" asp-route-id="@viajeId" class="btn btn-outline-secondary rounded-pill px-4">Cancelar</a>
            <button type="submit" class="btn btn-dark rounded-pill px-4">Guardar cambios</button>
        </div>
    </form>
</div>

<!-- Plantilla para agregar paradas desde JavaScript -->
<template id="plantilla-parada">
    <div class="card border rounded-4 p-3" data-parada-row>
        <div class="row g-2 align-items-center">
            <div class="col-auto">
                <span class="badge rounded-pill text-bg-dark parada-numero">1</span>
            </div>
            <div class="col">
                <input class="form-control" type="text" name="Paradas[0].Direccion" id="Paradas_0__Direccion"
                       placeholder="Ej.: Chacarita" maxlength="150" data-parada-direccion
                       data-val="true"
                       data-val-required="La dirección de la parada es obligatoria."
                       data-val-length="La dirección no puede superar los 150 caracteres."
                       data-val-length-max="150" />
                <span class="text-danger small d-block" data-valmsg-for="Paradas[0].Direccion" data-valmsg-replace="true"></span>
            </div>
            <div class="col-auto">
                <div class="btn-group" role="group" aria-label="Acciones de la parada">
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-mover-arriba
                            title="Mover arriba" aria-label="Mover parada arriba">
                        &uarr;
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" data-mover-abajo
                            title="Mover abajo" aria-label="Mover parada abajo">
                        &darr;
                    </button>
                    <button type="button" class="btn btn-outline-danger btn-sm" data-eliminar-parada
                            title="Eliminar" aria-label="Eliminar parada">
                        &times;
                    </button>
                </div>
            </div>
        </div>
    </div>
</template>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/viaje-crear.js" asp-append-version="true"></script>
}
