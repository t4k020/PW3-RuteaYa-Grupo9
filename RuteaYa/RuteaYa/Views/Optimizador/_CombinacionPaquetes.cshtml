@model RuteaYa.Servicios.Dtos.CombinacionDto

<ul class="list-group list-group-flush">
    @foreach (var p in Model.Paquetes)
    {
        <li class="list-group-item px-0 d-flex justify-content-between align-items-start gap-3">
            <div>
                <div class="fw-semibold">@p.Descripcion</div>
                <div class="text-muted small">@p.OrigenDir → @p.DestinoDir</div>
                <div class="text-muted small">@p.PesoKg.ToString("0.##") kg · desvío @p.DesvioKm.ToString("0.#") km (+@p.TiempoExtraMin min)</div>
            </div>
            <span class="fw-bold">$@p.Monto.ToString("N0")</span>
        </li>
    }
</ul>
