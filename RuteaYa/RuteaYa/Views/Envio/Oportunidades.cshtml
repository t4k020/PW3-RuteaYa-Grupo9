@model RuteaYa.Models.OportunidadesViewModel
@{
    ViewData["Title"] = "Oportunidades";
    var resultado = Model.Resultado;
}

<div class="container oportunidades-page py-3">
    <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-4">
        <div>
            <h1 class="h3 fw-bold mb-1">Oportunidades</h1>
            <p class="text-muted mb-0">Encontrá envíos compatibles con uno de tus viajes.</p>
        </div>
        <a asp-controller="Optimizador" asp-action="Index" class="btn btn-dark rounded-pill px-4 fw-semibold">Optimizar combinación</a>
    </div>

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger rounded-4">@error</div>
    }

    <form method="get" id="opportunities-form" class="opportunities-selector mb-4">
        <div class="row g-3 align-items-end">
            <div class="col-lg-5">
                <label class="form-label mb-1" for="viajeId">Viaje</label>
                <select class="form-select" id="viajeId" name="viajeId" required>
                    <option value="">Elegí un viaje</option>
                    @foreach (var viaje in Model.Viajes)
                    {
                        <option value="@viaje.Id" selected="@(Model.ViajeId == viaje.Id)">@viaje.OrigenDir → @viaje.DestinoDir</option>
                    }
                </select>
            </div>
            <div class="col-sm-5 col-lg-3">
                <label class="form-label mb-1" for="fecha">Fecha del viaje</label>
                <input class="form-control" id="fecha" name="fecha" type="date" min="@DateTime.Today.ToString("yyyy-MM-dd")" value="@Model.Fecha.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-sm-2 col-lg-2">
                <input type="hidden" id="orden" name="orden" value="@Model.Orden" />
                <button class="btn btn-dark w-100" type="submit">Buscar</button>
            </div>
        </div>
    </form>

    @if (resultado is not null)
    {
        <section class="opportunities-trip-summary mb-4">
            <div>
                <span class="summary-label">Viaje seleccionado</span>
                <strong>@resultado.OrigenDir → @resultado.DestinoDir</strong>
                <span class="text-muted small">@resultado.FechaViaje.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="summary-limits">
                <span><b>@resultado.CupoDisponible</b> paquetes</span>
                <span><b>@resultado.PesoDisponibleKg.ToString("0.##") kg</b> disponibles</span>
                <span><b>@resultado.DesvioDisponibleKm.ToString("0.#") km</b> de desvío</span>
            </div>
        </section>

        <div class="d-flex align-items-center gap-2 flex-wrap mb-3">
            <span class="small text-muted fw-semibold me-1">Ordenar por</span>
            <button class="sort-pill @(Model.Orden == "ganancia" ? "is-active" : "")" type="button" data-order="ganancia">Ganancia</button>
            <button class="sort-pill @(Model.Orden == "desvio" ? "is-active" : "")" type="button" data-order="desvio">Desvío</button>
            <button class="sort-pill @(Model.Orden == "compatibilidad" ? "is-active" : "")" type="button" data-order="compatibilidad">Compatibilidad</button>
        </div>

        @if (!resultado.Oportunidades.Any())
        {
            <div class="empty-opportunities text-center">No hay oportunidades que entren individualmente en los límites de este viaje.</div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var oportunidad in resultado.Oportunidades)
                {
                    var badgeClass = oportunidad.Compatibilidad == "Mucho desvío" ? "compat-warning" : "compat-good";
                    <article class="opportunity-card">
                        <div class="opportunity-route">
                            <h2>@oportunidad.OrigenDir → @oportunidad.DestinoDir</h2>
                            <p>@oportunidad.Descripcion · @oportunidad.PesoKg.ToString("0.##") kg · desvío estimado @oportunidad.DesvioKm.ToString("0.#") km</p>
                        </div>
                        <span class="compatibility-badge @badgeClass">@oportunidad.Compatibilidad</span>
                        <strong class="opportunity-amount">@oportunidad.Monto.ToString("C")</strong>
                        <div class="text-md-end text-center">
                            <a asp-action="DetallesOportunidad" asp-route-id="@oportunidad.Id" class="btn btn-outline-secondary rounded-pill px-3 w-100">Ver detalle</a>
                        </div>
                    </article>
                }
            </div>
        }
    }
    else
    {
        <div class="opportunities-hint">Seleccioná uno de tus viajes y una fecha para consultar las oportunidades compatibles.</div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('[data-order]').forEach(button => {
            button.addEventListener('click', () => {
                document.getElementById('orden').value = button.dataset.order;
                document.getElementById('opportunities-form').submit();
            });
        });
    </script>
}
