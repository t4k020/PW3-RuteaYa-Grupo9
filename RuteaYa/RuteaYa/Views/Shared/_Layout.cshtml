<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - RuteaYa</title>
    <partial name="_ThemeInit" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RuteaYa.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="d-flex min-vh-100">

        <!-- Barra lateral (Sidebar) -->
        <aside class="sidebar d-flex flex-column p-3 text-white">
            <a class="navbar-brand text-white fs-4 fw-bold mb-4 px-2 text-decoration-none" asp-controller="Home" asp-action="Index">
                RuteaYa
            </a>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item mb-1">
                    <!-- Clase 'active-link' para el ítem seleccionado -->
                    <a class="nav-link active-link text-white" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white opacity-75" asp-controller="Viaje" asp-action="Index">Mis viajes</a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white opacity-75" asp-controller="Envio" asp-action="Index">Mis envíos</a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white opacity-75" asp-controller="Envio" asp-action="Oportunidades">Oportunidades</a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white opacity-75" href="#">Optimizador</a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white opacity-75" asp-controller="Viaje" asp-action="MisTransportes">Mis transportes</a>
                </li>
                <li class="nav-item mb-1">
                    <a class="nav-link text-white opacity-75" asp-controller="Home" asp-action="Historial">Historial</a>
                </li>
            </ul>

            <!-- Sección de Usuario Inferior -->
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="mt-auto user-profile-box p-3 rounded">
                    <div class="fw-bold"> @User.Identity?.Name</div>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="m-0 p-0 mt-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm w-100 mt-2 fw-semibold">
                            Cerrar sesión
                        </button>
                    </form>
                </div>
            }
        </aside>

        <!-- Contenido Principal -->
        <div class="main-content flex-grow-1 d-flex flex-column">
            <header class="topbar d-flex justify-content-end align-items-center px-4 py-2">
                <button type="button" data-theme-toggle class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                    🌙 Modo oscuro
                </button>
            </header>

            <main role="main" class="p-4 pb-3 flex-grow-1">
                @RenderBody()
            </main>
        </div>

    </div>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>